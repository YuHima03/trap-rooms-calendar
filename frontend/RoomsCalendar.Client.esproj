<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6165494">

  <PropertyGroup>
    <StartupCommand>pnpm run dev</StartupCommand>
    <!-- This project uses pnpm for package management -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <!-- Allow custom build scripts defined in package.json -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>

  <!-- Build settings -->
  <PropertyGroup>
    <BuildCommand>pnpm run build</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\out</BuildOutputFolder>
  </PropertyGroup>

  <!-- Test settings -->
  <PropertyGroup>
    <TestCommand>pnpm run test</TestCommand>
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
  </PropertyGroup>
  
</Project>
